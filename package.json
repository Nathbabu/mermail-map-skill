{
  "name": "map-skill",
  "version": "0.2.0",
  "description": "Mermail Autonomous Procurement & Account Provisioner: email identities and payment-capable wallets for AI agents",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js",
    "./skill": "./dist/src/skill.js",
    "./client": "./dist/src/mermail-client.js",
    "./agent": "./dist/src/agent.js",
    "./types": "./dist/src/types.js"
  },
  "bin": {
    "map-skill": "./dist/src/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:watch": "node --test --watch dist/test/*.test.js",
    "demo": "npm run build && node dist/src/index.js demo",
    "repl": "npm run build && node dist/src/index.js repl",
    "serve": "npm run build && node dist/src/index.js serve",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "ai-agent",
    "mcp",
    "mermail",
    "usdc",
    "solana",
    "provisioning",
    "procurement"
  ],
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
