# Leave MERMAIL_API_KEY unset and the whole toolchain runs against the built-in
# simulator. That is the default for tests, CI and the demo; nothing here is
# required to get a green test run.

# --- Mermail API ------------------------------------------------------------
# Live mode switches on as soon as a key is present.
MERMAIL_API_KEY=
MERMAIL_API_URL=https://api.mermail.app

# Domain used when minting agent addresses (agent_<prefix>_<suffix>@<domain>).
MERMAIL_DOMAIN=mermail.app

# Force the simulator even when a key is present. Useful for dry runs.
MERMAIL_MODE=

# --- Inboxes ----------------------------------------------------------------
# How long a provisioned address accepts mail. 0 means it never expires.
MERMAIL_INBOX_TTL_SECONDS=86400

# Where Mermail should push inbound mail. Leave blank to poll instead.
# The REST server in this repo accepts deliveries at POST /webhooks/mermail.
MERMAIL_WEBHOOK_URL=

# --- Wallet -----------------------------------------------------------------
# Signing key handle for the agent wallet. Sent only on the routes that move
# money, never logged, never serialised into a tool result. Keep it out of git.
AGENT_WALLET_KEY=

# solana-mainnet | solana-devnet | simulation
# Anything other than solana-mainnet keeps the faucet endpoint enabled.
MERMAIL_NETWORK=solana-devnet

# --- Spend policy -----------------------------------------------------------
# The agent refuses to sign anything above these, regardless of what a vendor
# invoice asks for. Raise them on purpose, not by accident.
MAP_MAX_PER_TX_USD=25
MAP_MAX_TOTAL_USD=100
MAP_REQUIRE_APPROVAL_ABOVE_USD=10

# --- Timing -----------------------------------------------------------------
MAP_VERIFICATION_TIMEOUT_MS=60000
MAP_POLL_INTERVAL_MS=1000

# --- REST server (npm run serve) --------------------------------------------
PORT=8787
HOST=127.0.0.1
